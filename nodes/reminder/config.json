{
  "name": "reminder",
  "description": "Schedules reminders. Send a message with delay and text, it will publish the reminder when the time comes. Survives restarts via persistent state.",
  "tags": [
    "utility",
    "scheduler",
    "reminder"
  ],
  "default_authority": 0,
  "default_priority": 3,
  "ports": {
    "inputs": {
      "reminder.set": {
        "description": "Schedule a reminder. Payload: {delay: \"<duration>\", text: \"<message>\"}; fires on reminder.fire when due.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "delay": {
              "type": "string",
              "description": "e.g. '30s', '5m', '2h'"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "delay",
            "text"
          ]
        }
      },
      "time.tick": {
        "description": "Periodic wake from the clock node so due reminders can fire even when no reminder.set arrives.",
        "inputSchema": {
          "type": "object"
        }
      }
    },
    "outputs": {
      "reminder.ack": {
        "description": "reminder.ack"
      },
      "reminder.fire": {
        "description": "reminder.fire"
      }
    }
  },
  "default_port_bindings": {
    "inputs": {
      "reminder.set": [
        "reminder.set"
      ],
      "time.tick": [
        "time.tick"
      ]
    },
    "outputs": {
      "reminder.ack": [
        "reminder.ack"
      ],
      "reminder.fire": [
        "reminder.fire"
      ]
    }
  },
  "supports_transport": [
    "process"
  ]
}
