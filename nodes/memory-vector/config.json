{
  "name": "memory-vector",
  "description": "Vector memory store using LanceDB + Ollama embeddings. Supports semantic search, indexing text/documents, and RAG-style recall. Long-term memory with similarity search.",
  "tags": [
    "memory",
    "vector",
    "rag",
    "embeddings",
    "long-term"
  ],
  "default_authority": 0,
  "default_priority": 3,
  "ports": {
    "inputs": {
      "memory-vector.store": {
        "description": "Embed and store a piece of text. Payload: {text, metadata?}.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "metadata": {
              "type": "object"
            }
          },
          "required": [
            "text"
          ]
        }
      },
      "memory-vector.search": {
        "description": "Semantic similarity search over stored vectors. Payload: {query, top_k?}.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "top_k": {
              "type": "number"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      "memory-vector.index": {
        "description": "Index a directory of text/markdown files into the vector store. Payload: {path}.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      "memory-vector.reindex": {
        "description": "Drop and rebuild the vector store from all previously indexed sources. Payload: {} (no fields required).",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    "outputs": {
      "memory-vector.result": {
        "description": "memory-vector.result"
      }
    }
  },
  "default_port_bindings": {
    "inputs": {
      "memory-vector.store": [
        "memory-vector.store"
      ],
      "memory-vector.search": [
        "memory-vector.search"
      ],
      "memory-vector.index": [
        "memory-vector.index"
      ],
      "memory-vector.reindex": [
        "memory-vector.reindex"
      ]
    },
    "outputs": {
      "memory-vector.result": [
        "memory-vector.result"
      ]
    }
  },
  "supports_transport": [
    "process"
  ]
}
